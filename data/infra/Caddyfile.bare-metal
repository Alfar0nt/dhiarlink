# Dhiarlink — Caddy Reverse Proxy (Bare Metal / Non-Docker)
#
# This Caddyfile is for native Caddy running directly on the host.
# RoadRunner and the dashboard both run on the same machine.
#
# Installation:
#   sudo cp data/infra/Caddyfile.bare-metal /etc/caddy/Caddyfile
#   sudo systemctl restart caddy
#
# Caddy listens on port 3000 for cloudflared (system service).
# RoadRunner runs on localhost:8080.
# Dashboard (nginx) runs on localhost:8081.

{
	admin off
	auto_https off
}

:3000 {
	# Enable gzip + zstd compression for all responses
	encode gzip zstd

	# --- www.dhiarr.qzz.io — Landing page + REST API + redirect engine ---
	@landing host www.dhiarr.qzz.io
	handle @landing {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-Ip {remote_host}
		}
	}

	# --- app.dhiarr.qzz.io — Dashboard (dhiarlink-web-client) ---
	@dashboard host app.dhiarr.qzz.io
	handle @dashboard {
		reverse_proxy 127.0.0.1:8081 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-Ip {remote_host}
		}
	}

	# --- link.dhiarr.qzz.io — Short URL redirects ---
	@shortlinks host link.dhiarr.qzz.io
	handle @shortlinks {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-Ip {remote_host}
		}
	}

	# --- Catch-all: 404 for unrecognized hostnames ---
	handle {
		respond "Not Found" 404
	}
}
