# ==============================================================================
# Dhiarlink — Environment Configuration Reference
# ==============================================================================
# Copy this file to .env and fill in the values for your deployment.
# For production, pass these via your container orchestrator or Docker flags.
# For development, copy to config/params/dhiarlink_dev_env.php (PHP format).
# ==============================================================================

# --- Application ---------------------------------------------------------------
APP_ENV=prod                              # "prod" or "dev"
DHIARLINK_VERSION=latest                  # Shown in /rest/health endpoint
DHIARLINK_RUNTIME=rr                      # Runtime: "rr" (RoadRunner) or unset
DHIARLINK_SERVER_FORWARD_CREDENTIALS=false


# --- URL Shortener -------------------------------------------------------------
DEFAULT_DOMAIN=link.dhiarr.qzz.io              # The domain used for generated short URLs
IS_HTTPS_ENABLED=true                     # Whether short URLs use https://
# SHORT_URL_TRAILING_SLASH=false          # Append trailing slash to short URLs
# BASE_PATH=                              # Prefix path (e.g., /shortener)
# AUTO_RESOLVE_REDIRECTS=false            # Auto-resolve redirect chains for titles

# --- Database ------------------------------------------------------------------
# Supported drivers: mysql, maria, postgres, mssql, sqlite
DB_DRIVER=mysql
DB_HOST=dhiarlink_db
DB_PORT=3306
DB_NAME=dhiarlink
DB_USER=dhiarlink
DB_PASSWORD=<your-secure-db-password>
# DB_USE_ENCRYPTION=false                 # Require encrypted DB connections
# DB_UNIX_SOCKET=                         # MySQL/Maria only: connect via socket

# --- PostgreSQL example --------------------------------------------------------
# DB_DRIVER=postgres
# DB_HOST=dhiarlink_db_postgres
# DB_PORT=5432
# DB_NAME=dhiarlink
# DB_USER=postgres
# DB_PASSWORD=postgres

# --- Redis (caching + pub/sub) -------------------------------------------------
# REDIS_SERVERS=tcp://dhiarlink_redis:6379   # Comma-separated list for clusters
# REDIS_SENTINEL_SERVICE=                     # Sentinel service name
# REDIS_SERVERS_USER=                         # Redis AUTH username
# REDIS_SERVERS_PASSWORD=                     # Redis AUTH password
# REDIS_PUB_SUB_ENABLED=true                  # Enable real-time visit notifications
# CACHE_NAMESPACE=                            # Prefix for all cache keys

# --- Mercure (real-time updates) -----------------------------------------------
# MERCURE_ENABLED=true
# MERCURE_PUBLIC_HUB_URL=https://app.dhiarr.qzz.io/mercure
# MERCURE_INTERNAL_HUB_URL=http://dhiarlink_mercure_proxy
# MERCURE_JWT_SECRET=<your-jwt-secret>

# --- RabbitMQ (async task processing) ------------------------------------------
# RABBITMQ_ENABLED=false
# RABBITMQ_HOST=dhiarlink_rabbitmq
# RABBITMQ_PORT=5672
# RABBITMQ_USER=rabbit
# RABBITMQ_PASSWORD=rabbit

# --- Matomo (analytics) --------------------------------------------------------
# MATOMO_ENABLED=false
# MATOMO_BASE_URL=https://your-matomo-instance.com
# MATOMO_SITE_ID=1
# MATOMO_API_TOKEN=<your-matomo-api-token>

# --- GeoLite2 (IP geolocation) ------------------------------------------------
# GEOLITE_LICENSE_KEY=                    # Required for visit geolocation
#                                       # Get a free key at https://www.maxmind.com

# --- CORS (Cross-Origin Resource Sharing) --------------------------------------
CORS_ALLOW_ORIGIN=https://app.dhiarr.qzz.io                     # Allowed origins for your dashboard (regex or *)
# CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE
# CORS_ALLOW_HEADERS=                     # Extra allowed headers
# CORS_MAX_AGE=1800                       # Preflight cache (seconds)
# CORS_ALLOW_CREDENTIALS=false

# --- Tracking ------------------------------------------------------------------
# DISABLE_TRACKING=false                  # Disable all visit tracking
# DISABLE_TRACKING_FROM=                  # IP ranges to exclude from tracking
# DISABLE_IP_TRACKING=false               # Don't store visitor IPs
# DISABLE_REFERRER_TRACKING=false         # Don't store referrer URLs
# DISABLE_UA_TRACKING=false               # Don't store user-agent strings
# ANONYMIZE_REMOTE_ADDR=false             # Hash visitor IP addresses

# --- Not Found Redirects -------------------------------------------------------
# BASE_URL_REDIRECT=                      # Redirect for base URL visits
# INVALID_SHORT_URL_REDIRECT=             # Redirect for invalid short codes
# REGULAR_404_REDIRECT=                   # Redirect for non-short-URL 404s

# --- Delete Short URLs ---------------------------------------------------------
# DELETE_SHORT_URL_THRESHOLD=15           # Visits required before deleting
# CHECK_VISITS_THRESHOLD=true             # Enable visit threshold check

# --- Worker Pool Tuning (RoadRunner) -------------------------------------------
# WEB_WORKER_NUM=0                        # 0 = auto-detect CPU cores
# TASK_WORKER_NUM=0                       # 0 = auto-detect CPU cores

# --- Logs ----------------------------------------------------------------------
# LOGS_FORMAT=console                     # "console" (human) or "json" (structured)

# --- Short URL Slugs -----------------------------------------------------------
# SHORT_URL_MODE=strict                   # "strict" or "loose" character validation

# --- Reverse Proxy / Cloudflare Tunnel -----------------------------------------
# TRUSTED_PROXIES=1                       # Number of proxies in front of Dhiarlink
                                          # (1 = cloudflared, 2 = CF edge + cloudflared)
                                          # Can also be comma-separated IPs
# CLOUDFLARE_TUNNEL_TOKEN=                # Token from Cloudflare Zero Trust dashboard
                                          # (Only if using cloudflared as Docker container)

# --- Dashboard (dhiarlink-web-client) -----------------------------------------
# DHIARLINK_SERVER_URL=https://www.dhiarr.qzz.io   # Backend URL pre-configured in dashboard
# DHIARLINK_SERVER_API_KEY=<your-api-key>           # API key pre-configured in dashboard
# DHIARLINK_SERVER_NAME=Dhiarlink               # Display name in dashboard
DHIARLINK_SERVER_FORWARD_CREDENTIALS=false     # Forward browser credentials

# --- Database (Production) -----------------------------------------------------
DB_ROOT_PASSWORD=                       # MySQL root password (for initial setup)
# INITIAL_API_KEY=                        # Auto-creates first API key on container startup
                                          # Generate: openssl rand -hex 24
# DHIARLINK_IMAGE=dhiarlink:latest        # Custom image name/tag
# DHIARLINK_VERSION=latest                # Version embedded in health endpoint
