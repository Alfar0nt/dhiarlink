# ==============================================================================
# Dhiarlink — Environment Variables Reference
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: On bare metal, systemd loads this .env via EnvironmentFile,
# so these values OVERRIDE config/params/*.php. Use bare metal hostnames
# (localhost) here, NOT Docker container names.
# See documentation/deployment.md for full deployment guides.
# See documentation/deployment.md for full deployment guides.
# ==============================================================================

# --- Application ---
APP_ENV=prod
DHIARLINK_VERSION=1.0.0
DHIARLINK_RUNTIME=rr

# --- URL Shortener ---
DEFAULT_DOMAIN=link.dhiarr.qzz.io
IS_HTTPS_ENABLED=true
# SHORT_URL_TRAILING_SLASH=false
# BASE_PATH=
# AUTO_RESOLVE_REDIRECTS=false
# SHORT_URL_MODE=strict

# --- Database ---
# For Docker: use container hostnames below
# For bare metal: set DB_HOST=localhost, DB_DRIVER=maria
# Docker default — for bare metal, change to: DB_DRIVER=maria
DB_DRIVER=mysql
DB_HOST=dhiarlink_db
DB_PORT=3306
DB_NAME=dhiarlink
DB_USER=dhiarlink
DB_PASSWORD=<your-secure-db-password>
# DB_USE_ENCRYPTION=false
# DB_UNIX_SOCKET=

# --- Bare Metal Overrides ---
# Uncomment these for bare metal deployment:
# DB_HOST=localhost
# REDIS_SERVERS=tcp://127.0.0.1:6379

# --- Database (Docker Compose initial setup) ---
DB_ROOT_PASSWORD=<your-secure-root-password>
INITIAL_API_KEY=<generate-with-openssl-rand-hex-24>

# --- Redis ---
REDIS_SERVERS=tcp://dhiarlink_redis:6379
# REDIS_SENTINEL_SERVICE=
# REDIS_SERVERS_USER=
# REDIS_SERVERS_PASSWORD=
REDIS_PUB_SUB_ENABLED=true
# CACHE_NAMESPACE=

# --- Mercure (Real-Time Updates) ---
# MERCURE_ENABLED=false
# MERCURE_PUBLIC_HUB_URL=https://www.dhiarr.qzz.io/mercure
# MERCURE_INTERNAL_HUB_URL=http://dhiarlink_mercure
# MERCURE_JWT_SECRET=

# --- RabbitMQ (Optional Async Queue) ---
# RABBITMQ_ENABLED=false
# RABBITMQ_HOST=dhiarlink_rabbitmq
# RABBITMQ_PORT=5672
# RABBITMQ_USER=rabbit
# RABBITMQ_PASSWORD=rabbit

# --- Matomo (Analytics) ---
# MATOMO_ENABLED=false
# MATOMO_BASE_URL=
# MATOMO_SITE_ID=1
# MATOMO_API_TOKEN=

# --- GeoLite2 (IP Geolocation) ---
# Get a free license key at: https://www.maxmind.com/en/geolite2/signup
# GEOLITE_LICENSE_KEY=

# --- CORS ---
CORS_ALLOW_ORIGIN=https://app.dhiarr.qzz.io
# CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE
# CORS_ALLOW_HEADERS=
# CORS_MAX_AGE=1800
# CORS_ALLOW_CREDENTIALS=false

# --- Tracking & Privacy ---
# DISABLE_TRACKING=false
# DISABLE_TRACKING_FROM=
# DISABLE_IP_TRACKING=false
# DISABLE_REFERRER_TRACKING=false
# DISABLE_UA_TRACKING=false
# ANONYMIZE_REMOTE_ADDR=false

# --- Redirects ---
# BASE_URL_REDIRECT=
# INVALID_SHORT_URL_REDIRECT=
# REGULAR_404_REDIRECT=
# DELETE_SHORT_URL_THRESHOLD=15
# CHECK_VISITS_THRESHOLD=true

# --- Workers & Performance ---
WEB_WORKER_NUM=0          # 0 = auto-detect CPU cores
TASK_WORKER_NUM=0         # 0 = auto-detect CPU cores
LOGS_FORMAT=console       # 'console' for bare metal (systemd journal), 'json' for Docker

# --- Reverse Proxy ---
TRUSTED_PROXIES=1         # 1 = cloudflared; set to 2 if behind CF edge + cloudflared
# CLOUDFLARE_TUNNEL_TOKEN=  # NOT needed — cloudflared runs as system service

# --- Dashboard Pre-Configuration ---
# These auto-configure the server connection in the dashboard
# so users don't have to manually add it on first visit.
DHIARLINK_SERVER_URL=https://www.dhiarr.qzz.io
DHIARLINK_SERVER_API_KEY=<your-api-key>
DHIARLINK_SERVER_NAME=Dhiarlink
DHIARLINK_SERVER_FORWARD_CREDENTIALS=false
